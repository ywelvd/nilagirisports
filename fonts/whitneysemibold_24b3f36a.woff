    margin: 0px -10px;
}
.newest_product_list.slick-initialized.slick-slider .slick-slide img {
    /* width: 95%; */
    width: auto !important;
    height: auto !important;
    max-width: 100%;
    max-height: 200px;
    line-height: 200px;
    vertical-align: middle;
}
.product-fade-wrap {
   min-height: 200px;
    line-height: 200px;
  /*  width: 100% !important;*/
    height: auto;
  /* padding: 0px 30px;*/
    margin: 15px 0;
    /* min-width: 493px; */
    cursor: pointer;
}
.slick-slide img {
    padding: 5%;}

